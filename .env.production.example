POSTGRES_PASSWORD=change_this_to_a_strong_password
# Confirm the total connection limit of your Render/Postgres plan before increasing this value.
DB_POOL_MAX=20
WINGA_DOMAIN=winga.example.com
ACME_EMAIL=you@example.com
TRUST_PROXY_HEADERS=true
PAYMENT_WEBHOOK_SECRET=replace_with_a_distinct_random_hmac_secret_of_at_least_32_characters
PAYMENT_REFUND_WEBHOOK_URL=https://refund-provider.example.com/v1/refunds
PAYMENT_REFUND_WEBHOOK_SECRET=replace_with_a_distinct_32_byte_delivery_secret
PAYMENT_REFUND_CALLBACK_SECRET=replace_with_a_distinct_32_byte_callback_secret
# Cloudflare Stream direct upload, private playback, and scalable local token signing.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=wingamarket.com,www.wingamarket.com
CLOUDFLARE_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=900
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_JWK=
