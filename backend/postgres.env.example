DATABASE_URL=postgresql://postgres:postgres@localhost:5432/winga_app
DATABASE_SSL=false
PORT=3000
COMMERCE_REDISCOVERY_CONTROL_PERCENT=10
SEARCH_DEMAND_MIN_AUDIENCE=2
# Search gaps may start with one buyer; this does not lower trend/report privacy.
SEARCH_OPPORTUNITY_MIN_AUDIENCE=1
WINGA_GROWTH_ROOM_INVITES_ENABLED=false
# At least 32 random characters; server-only HMAC key for opaque invitation tokens.
WINGA_GROWTH_INVITE_SECRET=
ACCOUNT_RECOVERY_SECRET=
ACCOUNT_RECOVERY_DELIVERY_WEBHOOK_URL=
ACCOUNT_RECOVERY_DELIVERY_WEBHOOK_SECRET=
ACCOUNT_RECOVERY_CF_ACCESS_CLIENT_ID=
ACCOUNT_RECOVERY_CF_ACCESS_CLIENT_SECRET=
PAYMENT_REFUND_WEBHOOK_URL=
PAYMENT_REFUND_WEBHOOK_SECRET=
PAYMENT_REFUND_CALLBACK_SECRET=
PAYMENT_REFUND_SWEEP_INTERVAL_MS=60000
PAYMENT_REFUND_SWEEP_BATCH_SIZE=20

# Explicitly requested in-app demand resolution alerts; independent kill switch.
WINGA_GROWTH_DEMAND_RESOLUTION_ENABLED=false
