NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:change_this_password@localhost:5432/winga_app
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
TRUST_PROXY_HEADERS=false
ALLOW_LEGACY_BEARER_AUTH=true
WINGA_DATA_DIR=./data
WINGA_UPLOADS_DIR=./uploads
ADMIN_SEED_PASSWORD=
MODERATOR_SEED_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
ACCOUNT_RECOVERY_SECRET=
ACCOUNT_RECOVERY_DELIVERY_WEBHOOK_URL=
ACCOUNT_RECOVERY_DELIVERY_WEBHOOK_SECRET=
ACCOUNT_RECOVERY_CF_ACCESS_CLIENT_ID=
ACCOUNT_RECOVERY_CF_ACCESS_CLIENT_SECRET=
ALLOW_UNVERIFIED_MANUAL_PAYMENTS=false
ALLOW_LOCAL_DATA_STORE_IN_PRODUCTION=false
ALLOW_DEFAULT_ORIGIN_FALLBACK=false
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=wingamarket.com,www.wingamarket.com
CLOUDFLARE_STREAM_PLAYBACK_TOKEN_TTL_SECONDS=900
