{
  // Workers Builds: master, repository root, no build command.
  // Deploy: npx wrangler deploy --config wrangler.video-safety.jsonc --keep-vars
  // This configuration targets the safety adapter; wrangler.toml targets mkubwa.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winga-video-safety-adapter",
  "main": "./cloudflare/video-safety-adapter.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat",
    "global_fetch_strictly_public"],
  "workers_dev": true,
  "vars": {
    "ADAPTER_PUBLIC_URL": "https://winga-video-safety-adapter.willardmmbando.workers.dev",
    "HIVE_API_URL": "https://api.thehive.ai/api/v3/hive/visual-moderation",
    "WINGA_VIDEO_SAFETY_RESULT_URL": "https://wingamarket.com/api/media/videos/safety-results",
    "MEDIA_HOST_ALLOWLIST": ".videodelivery.net,.cloudflarestream.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
